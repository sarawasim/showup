# Copy to .env (never commit .env). Values below match compose.yaml.
DATABASE_URL=postgresql+psycopg://showup:showup@localhost:5432/showup

# At least 32 characters or the app refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional. Defaults shown.
# JWT_EXPIRE_MINUTES=10080
# CORS_ORIGINS=["http://localhost:8081"]

# Hosted database (Supabase, free tier). Only needed to run migrations against it or to deploy.
# Ask Nam Anh for the value; use the session pooler address with the postgresql+psycopg:// prefix.
# SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
