# Copy to .env (never commit .env). Values below match compose.yaml.
DATABASE_URL=postgresql+psycopg://showup:showup@localhost:5432/showup

# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional. Defaults shown.
# JWT_EXPIRE_MINUTES=10080
# CORS_ORIGINS=["http://localhost:8081"]
